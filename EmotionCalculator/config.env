# ═══════════════════════════════════════════════════
#  EmotionCalculator v2.0 — 仿生情绪引擎配置
# ═══════════════════════════════════════════════════

# 情绪自然衰减系数 (instant层每轮向session层靠拢的比例, 0~1)
EMOTION_DECAY_RATE=0.05

# 触发主动关心的担忧值阈值 [RESERVED for FlowLock]
WORRY_THRESHOLD=75

# 情绪状态持久化文件路径
EMOTION_STATE_FILE=emotion_state.json

# --- R4 AI合成层配置 ---
# VCP 本地或云端大模型 API 地址 (用于情绪坍缩)
VCP_API_URL=http://127.0.0.1:6005/v1/chat/completions

# API 密钥 (请确保与主服务器配置一致)
VCP_API_KEY=123456

# 用于情绪合成的轻量级快速模型
EMOTION_MODEL=gcli-gemini-3-pro-preview-maxthinking